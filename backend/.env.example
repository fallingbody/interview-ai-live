PORT=8000

JWT_SECRET=your_secure_random_jwt_secret

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/<database>?retryWrites=true&w=majority

# Gmail SMTP email service
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_google_app_password
EMAIL_SENDER=your_email@gmail.com

# AI Engine connection (Hugging Face)
AI_BACKEND_URL=https://your-huggingface-space-url.hf.space
AI_BACKEND_API_KEY=your_secure_flask_api_key

# Frontend URL for email links
USER_FRONTEND_URL=https://interview-ai-room.vercel.app

# Firebase Service Account (paste full JSON as a single-line string)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

